    {
      "type": "java",
      "name": "Debug - productService",
      "request": "launch",
      "mainClass": "nc.IsisProductServiceApplication",
      "projectName": "nc-product-service",
      "args": "--spring.config.import=optional:file:${workspaceFolder}/properties/application.yml,optional:file:${workspaceFolder}/properties/application-${input:activeProfile}.yml,optional:file:${workspaceFolder}/properties/productService.yml,optional:file:${workspaceFolder}/properties/productService-${input:activeProfile}.yml --spring.cloud.config.enabled=false --spring.profiles.active=${input:activeProfile}",
