{
  "version": "0.2.0",
  "inputs": [
    {
      "id": "activeProfile",
      "type": "pickString",
      "name": "Spring profile",
      "description": "Select the Spring profile to activate (verslodev = local dev)",
      "default": "verslodev",
      "options": [
        "verslodev",
        "estagdev",
        "uat",
        "prod"
      ]
    }
  ],
  "configurations": [
    {
      "type": "java",
      "name": "Debug - web",
      "request": "launch",
      "mainClass": "nc.IsisWebApplication",
      "projectName": "nc-web",
      "args": "--spring.config.import=optional:file:${workspaceFolder}/properties/application.yml,optional:file:${workspaceFolder}/properties/application-${input:activeProfile}.yml,optional:file:${workspaceFolder}/properties/web.yml,optional:file:${workspaceFolder}/properties/web-${input:activeProfile}.yml --spring.cloud.config.enabled=false --spring.profiles.active=${input:activeProfile}",
      "cwd": "${workspaceFolder}"
    },
    {
      "type": "java",
      "name": "Debug - activitiService",
      "request": "launch",
      "mainClass": "nc.IsisActivitiServiceApplication",
      "projectName": "nc-activiti-service",
      "args": "--spring.config.import=optional:file:${workspaceFolder}/properties/application.yml,optional:file:${workspaceFolder}/properties/application-${input:activeProfile}.yml,optional:file:${workspaceFolder}/properties/activitiService.yml,optional:file:${workspaceFolder}/properties/activitiService-${input:activeProfile}.yml --spring.cloud.config.enabled=false --spring.profiles.active=${input:activeProfile}",
      "cwd": "${workspaceFolder}"
    },
    {
      "type": "java",
      "name": "Debug - credentialsIdp",
      "request": "launch",
      "mainClass": "nc.IsisCredentialsIdentityProviderApplication",
      "projectName": "nc-credentials-idp",
      "args": "--spring.config.import=optional:file:${workspaceFolder}/properties/application.yml,optional:file:${workspaceFolder}/properties/application-${input:activeProfile}.yml,optional:file:${workspaceFolder}/properties/credentialsIdp.yml,optional:file:${workspaceFolder}/properties/credentialsIdp-${input:activeProfile}.yml --spring.cloud.config.enabled=false --spring.profiles.active=${input:activeProfile}",
      "cwd": "${workspaceFolder}"
    },
    {
      "type": "java",
      "name": "Debug - integrationService",
      "request": "launch",
      "mainClass": "nc.IsisIntegrationServiceApplication",
      "projectName": "nc-integration-service",
      "args": "--spring.config.import=optional:file:${workspaceFolder}/properties/application.yml,optional:file:${workspaceFolder}/properties/application-${input:activeProfile}.yml,optional:file:${workspaceFolder}/properties/integrationService.yml,optional:file:${workspaceFolder}/properties/integrationService-${input:activeProfile}.yml --spring.cloud.config.enabled=false --spring.profiles.active=${input:activeProfile}",
      "cwd": "${workspaceFolder}"
