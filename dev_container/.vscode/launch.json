      "cwd": "${workspaceFolder}"
    },
    {
      "type": "java",
      "name": "Debug - ldapIdp",
      "request": "launch",
      "mainClass": "nc.LdapIdpApplication",
      "projectName": "nc-ldap-idp",
      "args": "--spring.config.import=optional:file:${workspaceFolder}/properties/application.yml,optional:file:${workspaceFolder}/properties/application-${input:activeProfile}.yml,optional:file:${workspaceFolder}/properties/ldapIdp.yml,optional:file:${workspaceFolder}/properties/ldapIdp-${input:activeProfile}.yml --spring.cloud.config.enabled=false --spring.profiles.active=${input:activeProfile}",
