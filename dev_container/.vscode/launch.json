  "compounds": [
    {
      "name": "Debug - All Services",
      "configurations": [
        "Debug - web",
        "Debug - activitiService",
        "Debug - credentialsIdp",
        "Debug - integrationService",
        "Debug - integrationEstagService",
        "Debug - ldapIdp",
        "Debug - mailService",
