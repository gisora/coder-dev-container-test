{
	"name": "Base Coder Container",
	"build": {
		"dockerfile": "Dockerfile"
	},
	"workspaceFolder": "/workspaces/coder-dev-container-test",
	"features": {
		"ghcr.io/devcontainers/features/github-cli:1": {}
	},
	"remoteUser": "vscode",
	// "containerEnv": {
	// 	"UV_LINK_MODE": "copy"
	// },
	"runArgs": [
	 	"--name",
	 	"coder-base-devcontainer"
	],
	"customizations": {
		"vscode": {
			"extensions": [
				"github.vscode-pull-request-github"
			],
			"settings": {}
		}
	},
	"onCreateCommand": ".devcontainer/on-create.sh",
	"postCreateCommand": ".devcontainer/post-create.sh"
}
